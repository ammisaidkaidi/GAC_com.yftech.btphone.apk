<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ecall_root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView"
        android:background="@mipmap/bg_phone_call_middle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/imageViewAnimal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="90dp"
        android:scaleType="center"
        android:layout_marginStart="280dp"
        android:layout_marginEnd="280dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="140dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/becall_iv_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/bt_icon_ecall"
            android:scaleType="fitEnd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yftech.btphone.view.FontTextView
            android:textSize="40sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/becall_tv_name"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/name_ecall"
            app:fontType="@string/font_source_bold"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.yftech.btphone.view.FontTextView
                android:textSize="24sp"
                android:textColor="@color/white70"
                android:gravity="center"
                android:id="@+id/becall_tv_tip"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/income_call_income"
                app:fontType="@string/font_source_medium"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="24sp"
                android:textColor="@color/white70"
                android:gravity="center"
                android:id="@+id/becall_tv_time"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:fontType="@string/font_source_medium"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
