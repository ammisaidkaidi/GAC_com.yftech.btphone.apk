<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame"
    android:fitsSystemWindows="false"
    android:layout_width="1920dp"
    android:layout_height="720dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/linear"
        android:background="@mipmap/dialog_btn1_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="100"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp">
            <com.yftech.btphone.view.FontTextView
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="xxxxxxxxxxxxxxxxxxxxxx"
                android:maxLines="1"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="32sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="20dp"
                android:text="xxxssssssssssssxxxxxxsssssssss\10sssssssxxxxxxxxxxxsxxxxxx"
                android:maxLines="2"
                android:layout_weight="100"
                android:lineSpacingExtra="10dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="22dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linear1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textSize="32sp"
                    android:textColor="@android:color/white"
                    android:layout_gravity="center"
                    android:id="@+id/btn_centre"
                    android:background="@drawable/dialog_btn_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/string_ok"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
