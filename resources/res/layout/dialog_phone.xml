<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="59dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cons_before"
        android:background="@drawable/pic_card_bg_496px"
        android:visibility="visible"
        android:layout_width="@dimen/card_width"
        android:layout_height="@dimen/card_height">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/view_move"
            android:layout_width="85dp"
            android:layout_height="46dp"
            android:layout_marginTop="30dp">
            <View
                android:layout_gravity="center"
                android:background="#88ffffff"
                android:layout_width="45dp"
                android:layout_height="6dp"/>
        </FrameLayout>
        <include
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            layout="@layout/layout_call_people_msg_dialog"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/dialog_answer_img_hungup"
                    android:background="@drawable/cb_hangup_small"
                    android:layout_width="82dp"
                    android:layout_height="82dp"/>
                <ImageView
                    android:id="@+id/dialog_answer_img_answer"
                    android:background="@drawable/cb_answer_small"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="56dp"/>
                <ImageView
                    android:id="@+id/dialog_answer_img_ignore"
                    android:background="@drawable/cb_ignore_small"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="56dp"/>
                <ImageView
                    android:id="@+id/dialog_answer_img_exchange"
                    android:background="@mipmap/btphone_main_btn_switch"
                    android:visibility="gone"
                    android:layout_width="82dp"
                    android:layout_height="82dp"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="84dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_wait_parent"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="102dp">
                <TextView
                    android:id="@+id/tv_space"
                    android:background="#26ccddff"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_wait_big"
                    android:paddingLeft="40dp"
                    android:paddingRight="30dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="100dp">
                    <com.yftech.btphone.view.FontTextView
                        android:textSize="28sp"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/dialog_answer_head_big_wait"
                        android:background="@drawable/ic_head3"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="30dp"/>
                    <com.yftech.btphone.view.FontTextView
                        android:textSize="32dp"
                        android:textColor="@android:color/white"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/dialog_answer_name_big_wait"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="1xxxxxxxxxx1"
                        android:singleLine="true"
                        android:layout_marginStart="15dp"/>
                    <com.yftech.btphone.view.FontTextView
                        android:textSize="32dp"
                        android:textColor="@color/white70"
                        android:gravity="center_vertical"
                        android:id="@+id/dialog_answer_time_big_wait"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2xxxxxxxxxxxxxxxxxxxxxxxx"
                        android:singleLine="true"
                        android:layout_marginStart="15dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_small_small"
        android:background="@drawable/deskcall_btn_callbar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/dialog_answer_head_small_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.yftech.btphone.view.FontTextView
                    android:textSize="28sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/dialog_answer_head_small"
                    android:background="@drawable/ic_head3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="0dp"/>
            </LinearLayout>
            <com.yftech.btphone.view.FontTextView
                android:textSize="32sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/dialog_answer_name_small"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="200dp"
                android:text="xxxxxsssssxxx"
                android:maxLines="1"
                android:layout_marginStart="20dp"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="32sp"
                android:textColor="@color/white70"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/dialog_answer_time_small"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/income_call_waitting"
                android:singleLine="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_small_wait"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <com.yftech.btphone.view.FontTextView
                android:textSize="28sp"
                android:gravity="center"
                android:id="@+id/dialog_answer_head_wait"
                android:background="@drawable/ic_head3"
                android:layout_width="56dp"
                android:layout_height="56dp"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="32sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/dialog_answer_name_wait"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="200dp"
                android:text="xxxxxxx"
                android:maxLines="1"
                android:layout_marginStart="20dp"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="32sp"
                android:textColor="@color/white70"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/dialog_answer_time_wait"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/income_call_waitting"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
