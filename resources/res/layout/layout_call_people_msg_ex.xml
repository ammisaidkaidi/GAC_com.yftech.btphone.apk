<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/people_root_ex"
    android:layout_width="464dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="25dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="60sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_head_ex"
            android:background="@drawable/ic_head2"
            android:visibility="visible"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:text=""/>
    </FrameLayout>
    <TextView
        android:textSize="40sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_name_ex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="D"
        android:singleLine="true"/>
    <TextView
        android:textSize="30sp"
        android:textColor="@color/white70"
        android:gravity="center"
        android:id="@+id/tv_time_ex"
        android:layout_width="464dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/income_call_exchange"
        android:singleLine="true"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/img_exchange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:src="@mipmap/btphone_main_btn_switch"/>
</LinearLayout>
