<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="480dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="132dp"
            android:overScrollMode="never"
            android:layoutDirection="ltr"/>
        <ImageView
            android:layout_gravity="center"
            android:background="@mipmap/btp_pic_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.yftech.btphone.view.FontTextView
            android:textSize="32sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/tv_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_nothing"
            android:cursorVisible="true"/>
        <include
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            layout="@layout/layout_load"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_sync_rightnow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp">
            <com.yftech.btphone.view.FontTextView
                android:textSize="32sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_sync_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_address_book_tip"
                android:singleLine="false"
                app:fontType="@string/font_source_regular"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="@dimen/download_btn_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_get_now"
                android:background="@drawable/ic_sync_now"
                android:layout_width="@dimen/download_btn_width"
                android:layout_height="62dp"
                android:layout_marginTop="30dp"
                android:text="@string/main_sync_now"
                android:singleLine="true"
                app:fontType="@string/font_source_normal"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_sync_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp">
            <com.yftech.btphone.view.FontTextView
                android:textSize="32sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_rogress_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_addressbook_sync"
                app:fontType="@string/font_source_normal"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="28sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                app:fontType="@string/font_roboto_regular"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progressBar"
                android:layout_width="468dp"
                android:layout_height="15dp"
                android:layout_marginTop="40dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
    </FrameLayout>
    <include layout="@layout/layout_keyboard"/>
</androidx.constraintlayout.widget.ConstraintLayout>
