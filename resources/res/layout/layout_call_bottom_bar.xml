<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/bottom_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="55dp">
    <Button
        android:textSize="@dimen/phone_call_bar_text_size"
        android:textColor="@color/white70"
        android:gravity="center_horizontal"
        android:id="@+id/cb_hangup"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="@string/income_call_hungup"
        android:drawableTop="@drawable/cb_hangup"
        android:drawablePadding="8dp"
        android:layout_weight="1"
        android:textAllCaps="false"/>
    <Button
        android:textSize="@dimen/phone_call_bar_text_size"
        android:textColor="@color/white70"
        android:gravity="center_horizontal"
        android:id="@+id/cb_answer"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="@string/income_call_answer"
        android:drawableTop="@drawable/cb_answer"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="110dp"/>
    <Button
        android:textSize="@dimen/phone_call_bar_text_size"
        android:textColor="@color/white70"
        android:gravity="center_horizontal"
        android:id="@+id/cb_nute"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="@string/income_call_nute"
        android:includeFontPadding="false"
        android:drawableTop="@drawable/cb_nute"
        android:drawablePadding="8dp"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="110dp"/>
    <Button
        android:textSize="@dimen/phone_call_bar_text_size"
        android:textColor="@color/white70"
        android:gravity="center_horizontal"
        android:id="@+id/cb_phone"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="@string/income_call_phone"
        android:includeFontPadding="false"
        android:drawableTop="@drawable/cb_phone"
        android:drawablePadding="8dp"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="110dp"/>
    <CheckBox
        android:enabled="false"
        android:textSize="@dimen/phone_call_bar_text_size"
        android:textColor="@color/white70"
        android:gravity="center_horizontal"
        android:id="@+id/cb_keyboard"
        android:visibility="visible"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:button="@null"
        android:text="@string/income_call_keyboard"
        android:includeFontPadding="false"
        android:drawableTop="@drawable/cb_keyborad"
        android:drawablePadding="8dp"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="110dp"/>
    <Button
        android:textSize="@dimen/phone_call_bar_text_size"
        android:textColor="@color/white70"
        android:gravity="center_horizontal"
        android:id="@+id/cb_ignore"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="@string/income_call_ignore"
        android:drawableTop="@drawable/cb_ignore"
        android:drawablePadding="8dp"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="110dp"/>
</LinearLayout>
