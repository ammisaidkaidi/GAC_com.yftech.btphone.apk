<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_custom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/rela_contacts"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_constact"
                android:paddingLeft="30dp"
                android:paddingTop="122dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
            <ImageView
                android:layout_gravity="center"
                android:background="@mipmap/btp_pic_mask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.yftech.btphone.view.FontTextView
                android:textSize="28sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_empty_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_contacts_null"
                android:layout_centerInParent="true"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="start|bottom"
            android:orientation="horizontal"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="75dp"
            android:layout_marginStart="95dp">
            <com.yftech.btphone.view.FontTextView
                android:textSize="@dimen/contacts_used_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/tv_popular"
                android:layout_width="@dimen/contacts_used_width"
                android:layout_height="54dp"
                android:text="@string/used"
                android:singleLine="true"
                android:lineSpacingExtra="0dp"
                app:fontType="@string/font_source_medium"/>
            <com.yftech.btphone.view.SideIndexBar
                android:id="@+id/side_bar"
                android:layout_width="1300dp"
                android:layout_height="205dp"/>
        </LinearLayout>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/rela_person"
        android:background="#f2000000"
        android:paddingLeft="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/item_constact_detail"/>
    </RelativeLayout>
</FrameLayout>
